                    },
                    "editora": {
                        "type": "string",
                        "example": "Garnier"
                    },
                    "edicao": {
                        "type": "integer",
                        "example": 1
                    },
                    "ano_publicacao": {
                        "type": "string",
                        "example": "1899"
