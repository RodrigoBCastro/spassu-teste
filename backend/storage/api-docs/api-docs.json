                "type": "object"
            },
            "LivroInput": {
                "required": [
                    "titulo",
                    "editora",
                    "edicao",
                    "ano_publicacao",
                    "valor",
                    "autores_ids",
                    "assuntos_ids"
                ],
                "properties": {
                    "titulo": {
                        "type": "string",
                        "example": "Dom Casmurro",
                        "maxLength": 40
                    },
                    "editora": {
                        "type": "string",
                        "example": "Garnier",
                        "maxLength": 40
                    },
                    "edicao": {
                        "type": "integer",
                        "example": 1,
                        "minimum": 1
                    },
                    "ano_publicacao": {
                        "type": "string",
                        "example": "1899"
                    },
                    "valor": {
                        "type": "number",
                        "format": "float",
                        "example": 29.9,
                        "minimum": 0
                    },
                    "autores_ids": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        },
                        "example": [
                            1,
                            2
                        ]
                    },
                    "assuntos_ids": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        },
                        "example": [
                            1
                        ]
                    }
                },
                "type": "object"
            },
            "RelatorioLivro": {
                "properties": {
                    "cod_l": {
                        "type": "integer",
                        "example": 1
                    },
                    "titulo": {
                        "type": "string",
                        "example": "Dom Casmurro"
                    },
                    "editora": {
                        "type": "string",
                        "example": "Garnier"
                    },
                    "edicao": {
                        "type": "integer",
                        "example": 1
                    },
                    "ano_publicacao": {
                        "type": "string",
                        "example": "1899"
                    },
                    "valor": {
                        "type": "number",
                        "format": "float",
                        "example": 29.9
                    },
                    "assuntos": {
                        "type": "string",
                        "example": "Romance, Realismo"
                    }
                },
                "type": "object"
            },
            "RelatorioAutor": {
                "properties": {
